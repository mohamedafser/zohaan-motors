{
  "name": "zohaan-motors",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3003",
    "build": "next build",
    "start": "next start --port 3003",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "db:generate": "tsx scripts/database/generate.mts",
    "db:sync": "tsx scripts/database/sync.mts",
    "db:check": "tsx scripts/database/check.mts",
    "db:studio": "drizzle-kit studio",
    "db:erd": "tsx scripts/database/erd.mts",
    "db:erd:check": "tsx scripts/database/erd.mts --check",
    "db:test:drizzle": "tsx --test scripts/database/*.test.ts",
    "db:seed": "supabase db query -f supabase/seed.sql",
    "db:types": "supabase gen types typescript --local > src/types/database.ts",
    "db:types:linked": "supabase gen types typescript --linked > src/types/database.ts",
    "db:test:constraints": "supabase db query -f supabase/tests/constraint_checks.sql",
    "db:test:security": "supabase db query -f supabase/tests/rls_security_checks.sql",
    "db:test:inventory": "supabase db query -f supabase/tests/phase5_inventory.sql",
    "db:test:acquisitions": "supabase db query -f supabase/tests/phase6_acquisitions.sql",
    "db:test:inspections": "supabase db query -f supabase/tests/phase7_inspections.sql",
    "test": "node scripts/test-vehicle-transitions.mjs && node scripts/test-acquisition-transitions.mjs && node scripts/test-inspection-transitions.mjs && node scripts/test-vehicle-photo-validation.mjs && node scripts/test-acquisition-document-validation.mjs && node scripts/test-vehicle-catalog.mjs && node scripts/test-email-verification.mjs",
    "catalog:generate": "node scripts/generate-vehicle-catalog-seed.mjs",
    "test:transitions": "node scripts/test-vehicle-transitions.mjs && node scripts/test-acquisition-transitions.mjs && node scripts/test-inspection-transitions.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@hookform/resolvers": "^5.9.1",
    "@next/env": "16.3.7",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "@tanstack/react-query": "^5.104.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.3",
    "lucide-react": "^1.49.0",
    "next": "16.3.7",
    "next-intl": "^4.14.8",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.0.15",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.89.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "^2.118.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
