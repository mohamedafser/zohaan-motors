# Public Supabase settings. These values are exposed to the browser.
# Copy this file to .env.local and replace the placeholders. Do not commit .env.local.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Use either the legacy anon key or the dashboard "publishable" key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Optional. Used as the password-reset redirect origin when the request has no Origin header.
NEXT_PUBLIC_SITE_URL=http://localhost:3003

# Server-only. Never prefix with NEXT_PUBLIC_.
# Required for the hidden first Super Admin bootstrap page.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# At least 16 characters. Leave empty to disable /setup/bootstrap (returns 404).
BOOTSTRAP_SECRET=change-me-to-a-long-random-secret

# Do not add SUPABASE_SERVICE_ROLE_KEY anywhere with a NEXT_PUBLIC_ prefix.
# For CLI migrations against a remote project, use `npx supabase link` (stores
# credentials outside git) rather than putting the database password in this file.
