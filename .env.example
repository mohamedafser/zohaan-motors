# Public Supabase settings. These values are exposed to the browser.
# Copy this file to .env.local and replace the placeholders. Do not commit .env.local.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional. Used as the password-reset redirect origin when the request has no Origin header.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Do not add SUPABASE_SERVICE_ROLE_KEY here or anywhere with a NEXT_PUBLIC_ prefix.
# Service-role access is intentionally omitted until a later server-only phase.
